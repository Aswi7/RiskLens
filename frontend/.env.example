# RiskLens Frontend Environment Variables

# Base URL for the FastAPI Backend API
VITE_API_URL=http://localhost:8000

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> Credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Note: External APIs (Google Places, Gemini, etc.) are securely proxied
# through the FastAPI backend to protect API keys from client-side exposure.
